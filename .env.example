# Chave da API da OpenAI (obrigatória). Gere em https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opcional. Navegador de onde importar cookies do Instagram quando o link pedir login.
# Deixe vazio para tentar sem login primeiro e, se falhar, tentar
# chrome/firefox/safari/edge automaticamente. Ou fixe um: chrome | firefox | safari | edge
COOKIES_FROM_BROWSER=
